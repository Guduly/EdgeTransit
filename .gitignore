
# ==========================================
# 1. Build and Compilation Artifacts
# ==========================================
# Ignore the entire build directory where CMake/Ninja outputs everything
build/
.cache/
CMakeFiles/
CMakeCache.txt
Makefile
cmake_install.cmake
ninja.build
*.ninja

# Object files and dependency files generated by the compiler
*.o
*.obj
*.d
*.crf

# ==========================================
# 2. Final Microcontroller Binaries
# ==========================================
# Never commit the actual flashable binaries
*.elf
*.bin
*.hex
*.map
*.axf

# ==========================================
# 3. Code Editor & Tool Settings
# ==========================================
# VS Code settings and workspace files
.vscode/
*.code-workspace

# Neovim / Vim swap and backup files
*.swp
*.swo
*~
.netrwhist

# STM32CubeIDE / Eclipse specific project files (if you ever open it there)
.project
.cproject
.settings/

# ==========================================
# 4. System & Miscellaneous
# ==========================================
.DS_Store
Thumbs.db
